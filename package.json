{
  "name": "asean-qr",
  "version": "0.1.0",
  "description": "Parse, validate and generate Southeast Asian payment QR codes (EMVCo): DuitNow, PayNow, PromptPay, QRIS and VietQR. Zero dependencies.",
  "keywords": [
    "emvco",
    "qr",
    "payment",
    "duitnow",
    "paynow",
    "sgqr",
    "promptpay",
    "qris",
    "vietqr",
    "napas",
    "asean",
    "malaysia",
    "singapore",
    "thailand",
    "indonesia",
    "vietnam",
    "fintech"
  ],
  "license": "MIT",
  "author": "Ahmad Amirizal Rahmat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amirizalrahmat0799/asean-qr.git"
  },
  "homepage": "https://github.com/amirizalrahmat0799/asean-qr#readme",
  "bugs": "https://github.com/amirizalrahmat0799/asean-qr/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "asean-qr": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:package": "publint && attw --pack . --profile node16",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run check:package",
    "smoke": "node scripts/smoke.cjs && node scripts/smoke.mjs && node dist/cli.js validate 00020201021126410014A000000615000101065016640209123456789520499995303458540510.005802MY5909QRCSDNBHD6005BANGI6304343F"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "paynowqr": "^1.1.2",
    "promptpay-qr": "^0.5.0",
    "publint": "^0.3.25",
    "qris-dinamis": "^1.0.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vietnam-qr-pay": "^1.5.1",
    "vitest": "^5.0.3"
  }
}
